{
    "name": "innmind/git",
    "type": "library",
    "description": "Git abstraction",
    "homepage": "http://github.com/Innmind/Git",
    "license": "MIT",
    "authors": [
        {
            "name": "Baptiste Langlade",
            "email": "baptiste.langlade@hey.com"
        }
    ],
    "support": {
        "issues": "http://github.com/Innmind/Git/issues"
    },
    "require": {
        "php": "~8.4",
        "innmind/foundation": "~2.1"
    },
    "autoload": {
        "psr-4": {
            "Innmind\\Git\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Innmind\\Git\\": "tests/"
        }
    },
    "require-dev": {
        "symfony/filesystem": "~6.0|~7.0|~8.0",
        "innmind/static-analysis": "~1.3",
        "innmind/black-box": "~6.5",
        "innmind/coding-standard": "~2.0"
    }
}
